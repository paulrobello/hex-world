// Bank stones and reed clumps are runtime scatter (owner, 2026-10-26: "scatter type items like rocks and
// reeds should not be built into the tile"), a seeded 0 to 4 per tile (`hex-play` scatter RIVER_MAX).
// The road (edges 1-4) crosses the river (edges 0-3) at 60 degrees on a bridge.
(
    id: "river_road_bridge",
    biome: Grass,
    base: "river_straight_base",
    edges: (
        (kind: River, lane: Some((offset: 0.0, width: 8.0))),
        (kind: Road, lane: Some((offset: 0.0, width: 6.0))),
        (kind: Grass),
        (kind: River, lane: Some((offset: 0.0, width: 8.0))),
        (kind: Road, lane: Some((offset: 0.0, width: 6.0))),
        (kind: Grass),
    ),
    center: Some("river_road_bridge_center"),
    networks: [
        (kind: River, from: Edge(0), to: Edge(3)),
        (kind: Road, from: Edge(1), to: Edge(4)),
    ],
    props: (
        scatter: [
            (piece: "river_stones", density: 0.75),
            (piece: "river_reeds", density: 0.6),
        ],
    ),
)
