// The pine forest: dense spruce scatter, rocks, drifts of ferns, now and then a fallen log, and an
// undergrowth of shrubs and saplings, no oak (owner U3). Each later rule comes after the earlier
// ones so those keep their spots, except the granite outcrop and boulders (owner A25) and then the
// fallen log, which lead: their 1.5-4.25 m reach does not fit between placed spruces. Its id stays
// "forest" so saves, scenarios and the perf worlds keep loading as pine forests.
(
    id: "forest",
    biome: Forest,
    base: "forest_base",
    edges: (
        (kind: Forest),
        (kind: Forest),
        (kind: Forest),
        (kind: Forest),
        (kind: Forest),
        (kind: Forest),
    ),
    props: (
        scatter: [
            (piece: "outcrop_granite", density: 0.2),
            (piece: "boulder_granite", density: 0.4),
            (piece: "log_fallen", density: 0.15),
            (piece: "tree_forest", density: 3.0),
            (piece: "rock_small", density: 0.2),
            (piece: "fern_clump", density: 1.2, drift: true),
            (piece: "shrub_forest", density: 0.4),
            (piece: "sapling_spruce", density: 0.3),
        ],
    ),
)
