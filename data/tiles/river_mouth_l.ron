// River mouth, mirrored (owner Q1, 2026-10-14): `river_mouth` reflected across the coast's seaward
// axis, so the river arrives on edge 4 instead of edge 3. Authored mirrored in Blender; the engine
// never mirrors. Ocean on 0-1, beach on 2 (land right, the corner shared with grass edge 3) and 5
// (land left, the corner shared with the River edge).
(
    id: "river_mouth_l",
    biome: Beach,
    base: "river_mouth_l_base",
    edges: (
        (kind: Ocean),
        (kind: Ocean),
        (kind: Beach, land: Some(Right)),
        (kind: Grass),
        (kind: River, lane: Some((offset: 0.0, width: 8.0))),
        (kind: Beach, land: Some(Left)),
    ),
    center: Some("river_mouth_l_center"),
    nodes: [
        (id: "mouth", at: (0.0, 0.0)),
    ],
    networks: [
        (kind: River, from: Edge(4), to: Node("mouth")),
    ],
)
