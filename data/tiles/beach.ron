// Straight coast along edges 2 and 5: ocean on 0-1, grass on 3-4. Looking out from the tile, edge 2
// has the land on its right (the corner it shares with grass edge 3) and edge 5 on its left (the
// corner it shares with grass edge 4).
(
    id: "beach",
    biome: Beach,
    base: "beach_base",
    edges: (
        (kind: Ocean),
        (kind: Ocean),
        (kind: Beach, land: Some(Right)),
        (kind: Grass),
        (kind: Grass),
        (kind: Beach, land: Some(Left)),
    ),
    center: None,
    props: (
        scatter: [
            (piece: "beach_driftwood", density: 0.452),
            (piece: "beach_dunegrass", density: 1.805),
            (piece: "beach_pebbles", density: 0.752),
            (piece: "boulder_granite", density: 0.06),
        ],
    ),
)
