// Socket compatibility (PRD §5.2, plan F2, owner O1) and lane contract (plan F3).
// `compatible` must list every kind and be symmetric; the loader rejects anything else.
// Changing a lane width means changing every tile that carries that lane in the same commit.
(
    compatible: {
        Grass: [Grass, Forest],
        Forest: [Grass, Forest],
        Road: [Road],
        River: [River],
        // A coast never steps against grass or ocean: beach edges meet only beach edges.
        Beach: [Beach],
        Ocean: [Ocean],
        // P3 rail meets only rail, as a road does. The one exception is not a kind pair, so it
        // lives in hex-core `TileCatalog::edges_meet` (owner, 2026-10-25): a rail end that gets a
        // buffer stop also meets a tile that carries no rail, as grass, because the stop closes
        // the line there.
        Rail: [Rail],
    },
    lanes: {
        // scripts/blender/kit/_road.py ROAD_WIDTH
        Road: (offset: 0.0, width: 6.0),
        // Water width. Provisional until the river asset family is modeled (F3).
        River: (offset: 0.0, width: 8.0),
        // scripts/blender/kit/_rail.py: the 3.5 m ballast lane of every rail piece's socket-lane-*
        // extras. The rail meets the hex border itself (one shared section), so Rail has no edge
        // piece.
        Rail: (offset: 0.0, width: 3.5),
    },
    edge_pieces: {
        Road: "road_straight_edge",
        River: "river_edge",
    },
    // Decision D3: pieces chosen by the socket pair across an edge, placed in addition to
    // `edge_pieces`. forest_base keeps a grass rim (it joins meadow without a joint), so a
    // Forest/Forest seam lays litter over each tile's half of the rim. forest_base is not
    // 60-degree symmetric, so `per_base_edge` picks the variant for the base's local edge k
    // (`forest_forest_edge_e<k>`). `corners: Straight` is option O-a; `Taper` (O-b, owner choice
    // pending) would add `_t<p><n>` variants wherever an adjacent edge is not the same pair.
    pair_edge_pieces: [
        (own: Forest, neighbour: Forest, piece: "forest_forest_edge", per_base_edge: true, corners: Straight),
    ],
    // Owner O1: a beach edge's ground runs from grass height at its land end to the seabed at its
    // sea end. Each beach edge names its land side, looking out across the edge from its own tile
    // (`land: Some(Right)` puts the land at the corner shared with the next edge clockwise), and
    // meets only the opposite side, so the coast continues the same way across every seam.
    directional: [Beach],
)
