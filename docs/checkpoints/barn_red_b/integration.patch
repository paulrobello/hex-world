+                let start = (turn * (centre_local + yaw * Vec3::new(along, 0.0, 8.0))).xz()
+                    + centre(cell.q, cell.r);
+                if g.stand(start).is_err() {
+                    continue;
+                }
+                let s = walk(&g, start, -front, 8.0);
